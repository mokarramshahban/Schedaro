# ==========================================
# 15. IMPORTANT FILES TO KEEP TRACKABLE
# ==========================================

# Do NOT ignore:
#
# README.md
# LICENSE
# CONTRIBUTING.md
# AGENTS.md
# REQUIREMENTS.md
# docs/ (public documents only)
# frontend/src/
# frontend/public/ (approved assets only)
# backend/app/
# backend/alembic/
# backend/alembic/versions/
# package.json
# package-lock.json
# pnpm-lock.yaml
# yarn.lock
# requirements.txt
# pyproject.toml
# compose.yaml
# Dockerfile
# .dockerignore
# .gitignore
# .env.example
#
# These files are essential for development,
# reproducibility and documentation.
