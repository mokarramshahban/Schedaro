COMPOSE_PROJECT_NAME=schedaro
APP_ENV=development
FRONTEND_HOST_PORT=5174
BACKEND_HOST_PORT=8001
POSTGRES_DB=schedaro_db
POSTGRES_USER=schedaro_app
POSTGRES_PASSWORD=replace-with-a-fresh-local-development-password
DATABASE_URL=postgresql+psycopg://schedaro_app:replace-with-a-fresh-local-development-password@db:5432/schedaro_db
PLATFORM_DATABASE_NAME=schedaro_platform
ALLOWED_CORS_ORIGINS=http://localhost:5174
PUBLIC_APP_URL=http://localhost:5174
EMAIL_BACKEND=local
INVITATION_EXPIRY_HOURS=72
VITE_API_URL=http://localhost:8001
